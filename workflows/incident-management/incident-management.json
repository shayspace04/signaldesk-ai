          "type": "object"
        },
        "ui_schema": null
      },
      "id": "manager_review",
      "label": "Manager review",
      "position": null,
      "type": "FORM"
    },
    {
      "config": {
        "rules": [
          {
            "condition": "manager_review.approved == `true`",
            "next_node_id": "assign_owner"
          }
        ]
      },
      "id": "review_decision",
      "label": "Approved?",
      "position": null,
